# ============================================================
# MYJOBHACK — every environment variable the code reads.
#
# This file documented 6 of the 26 the code actually looks for, so a feature
# could be silently dead on Vercel with nothing to point at. Each one below
# says what breaks when it is missing, because that is the question you have
# when something does not work.
#
# REQUIRED means the app does not function without it. The rest have defaults,
# and the default is stated.
# ============================================================

# ---------- Supabase. REQUIRED ----------
# The URL and anon key are public: they ship inside the browser bundle, and
# that is by design. The service role key is NOT. It bypasses row level
# security entirely, so it belongs in the server environment only and must
# never be given a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=https://yourproject.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Where the app lives. REQUIRED in production ----------
# Every link in every email is built from this. Missing, it falls back to
# https://app.myjobhack.co, so on any other domain the buttons in your emails
# point at the wrong site and nobody can tell from the app.
NEXT_PUBLIC_APP_URL=https://app.myjobhack.co

# ---------- Email. RESEND_API_KEY is REQUIRED ----------
# Absent: nothing sends. Confirmation emails, offer letters, interview
# invitations and application receipts all fail, and several call sites report
# success anyway, so the only sign is that mail never arrives.
RESEND_API_KEY=
# Who the mail comes from, and where replies land. Defaults are in lib/resend.ts.
RESEND_FROM=MYJOBHACK <hello@myjobhack.co>
RESEND_REPLY_TO=hello@myjobhack.co
MAIL_FROM_NAME=MYJOBHACK
MAIL_FROM_EMAIL=hello@myjobhack.co

# Brevo is the fallback when Resend's daily allowance is spent. Absent, there
# is no fallback and bulk sending simply stops at the Resend cap, silently.
BREVO_API_KEY=
# Daily caps the app enforces for itself, so it stops before the provider does.
# Defaults: 90 and 280.
EMAIL_DAILY_CAP=90
BREVO_DAILY_CAP=280
# Where first party application alerts go. Falls back to RESEND_REPLY_TO.
OPS_NOTIFY_EMAIL=

# ---------- Payments ----------
# Absent: card payment is unavailable and says so clearly, which is handled
# well. Manual bank transfer still works.
PAYSTACK_SECRET_KEY=

# ---------- AI. GEMINI_API_KEY ----------
# Absent: CV scoring, the competency assessments, the job composer and the
# seeker toolkit all stop. The apply route scores in a best effort catch, so
# applicants are silently left unranked rather than erroring.
GEMINI_API_KEY=
# Default model and pacing. Defaults are in lib/gemini.ts.
GEMINI_MODEL=
AI_PACE_MS=
# How many CVs one apply burst will auto score. Default 150.
AUTO_SCORE_LIMIT=150

# ---------- File storage, Cloudflare R2 ----------
# All five or none. Absent: uploads silently fall back to Supabase storage,
# which is the bucket R2 was introduced to stop filling. Nothing warns you;
# you find out from the Supabase bill.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_NAMESPACE=

# ---------- Scheduled jobs. REQUIRED for the three crons ----------
# Set this BEFORE deploying. The cron routes now fail closed: with no secret
# they answer 503 rather than running, because the previous check accepted a
# user agent header that any caller can set, which let anyone fire the drip
# email run. Vercel sends this as a bearer token once the variable is set on
# the project. Generate at least 32 random characters.
CRON_SECRET=

# ---------- WordPress marketing site ----------
# Absent: publishing a job skips the cache flush, so the public site keeps
# showing the old list and the app gives no sign anything was missed.
WP_SITE_URL=
WP_FLUSH_SECRET=
